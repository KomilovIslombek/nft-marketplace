# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it's gitignored on purpose.

# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/?appName=Cluster0"

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# URL of the frontend, used for CORS in production only — in development,
# server.js already accepts 127.0.0.1/localhost on ports 5500/5501/5502/3000
# (covers Live Server's default of 5500 and this project's docs of 5501)
# without needing this to match exactly. Still set it for when NODE_ENV=production.
FRONTEND_URL="http://127.0.0.1:5501"

# development | production
NODE_ENV="development"

# Port the API server listens on (defaults to 5000 if unset)
PORT=5000
