# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it's gitignored on purpose.
# In production (Render) these are set in the dashboard instead — see
# docs/DEPLOYMENT.md. .env is only for running locally.

# MongoDB Atlas connection string. Put a database name after the host
# (here "nft-marketplace") so local and production can use different ones.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/nft-marketplace?retryWrites=true&w=majority&appName=Cluster0"

# Secret used to sign JWTs — a long random string. Production uses its own
# (Render generates one); never reuse the local value there.
JWT_SECRET="change-me-to-a-long-random-string"

# Google OAuth client ID (Google Cloud Console -> Credentials). Only the ID
# is needed: the backend verifies Google ID tokens, it never exchanges a
# code, so there is no client secret anywhere in this app.
GOOGLE_CLIENT_ID=""

# Allowed frontend origin(s) for CORS — used only when NODE_ENV=production.
# Comma-separate several, e.g. "https://my-site.netlify.app,https://mydomain.com".
# In development, app.js already accepts 127.0.0.1/localhost on ports
# 5500/5501/5502/3000, so this value doesn't matter locally.
FRONTEND_URL="http://127.0.0.1:5501"

# development | production
NODE_ENV="development"

# Port the API server listens on (defaults to 5000; Render sets its own)
PORT=5000

# Optional. DNS resolvers to use for the mongodb+srv lookup, comma-separated.
# In development config/db.js defaults to 1.1.1.1/8.8.8.8 because some local
# networks fail SRV lookups; in production it leaves the host's DNS alone.
# DNS_SERVERS="1.1.1.1,8.8.8.8"

# Optional, local only. Password for the demo creators created by
# `npm run seed`. Unset = a random one each run (nobody can log in as them).
# Never set this when seeding the production database.
# DEMO_PASSWORD=""
